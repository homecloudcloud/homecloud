#!/bin/bash
set -e

# Clean up any non-executable files in APT post-invoke directory
if [ -d /etc/apt/post-invoke.d ]; then
    find /etc/apt/post-invoke.d -type f ! -executable -delete 2>/dev/null || true
fi

# Copy hostapd.conf to /etc/hostapd
if [ -f /etc/homecloud/hostapd.conf ]; then
    mkdir -p /etc/hostapd  # Ensure directory exists

    # Create backup of original file if it exists
    if [ -f /etc/hostapd/hostapd.conf ]; then
        cp -f /etc/hostapd/hostapd.conf /etc/hostapd/hostapd.conf.bak
    fi

    cp -f /etc/homecloud/hostapd.conf /etc/hostapd/hostapd.conf
    chmod 644 /etc/hostapd/hostapd.conf

    systemctl is-active --quiet hostapd && systemctl restart hostapd || true
fi

if [ -f /sbin/apt-auto-repair.sh ]; then
    chmod +x /sbin/apt-auto-repair.sh
fi

cp -f /opt/homecloud/docker-compose.yml /etc/password-reset/docker-compose.yml 
cp -f /opt/homecloud/docker-compose-duplicati.yaml /etc/duplicati/docker-compose-duplicati.yaml
cp -f /opt/homecloud/docker-compose-duplicati.yaml /etc/homecloud/docker-compose-duplicati.yaml
cp -f /etc/dnsmasq.conf.orig /etc/dnsmasq.conf || true
cp -f /etc/homecloud/logrotate.conf /etc/logrotate.conf
cp -f /etc/homecloud/journald.conf /etc/systemd/journald.conf
cp -f /etc/homecloud/95openmediavault-unattended-upgrades /etc/apt/apt.conf.d/95openmediavault-unattended-upgrades
cp -f /etc/homecloud/sources.list /etc/apt/sources.list
cp -f /etc/homecloud/docker.list /etc/apt/sources.list.d/docker.list
cp -f /etc/homecloud/raspi.list /etc/apt/sources.list.d/raspi.list
cp -f /etc/duplicati/service_watcher.sh /var/lib/duplicati/shared/service_watcher.sh || true
cp -f /etc/duplicati/duplicati_backup_hook_urbackup_pre.sh /var/lib/duplicati/shared/duplicati_backup_hook_urbackup_pre.sh || true
cp -f /etc/duplicati/duplicati_backup_hook_urbackup_post.sh /var/lib/duplicati/shared/duplicati_backup_hook_urbackup_post.sh || true
cp -f /etc/duplicati/duplicati_backup_hook_urbackup_snapshot_pre.sh /var/lib/duplicati/shared/duplicati_backup_hook_urbackup_snapshot_pre.sh || true
cp -f /etc/traefik/traefik.yaml /etc/traefik/traefik.yaml || true

# Copy systemd-udevd.service to /etc/systemd/system
if [ -f /etc/homecloud/systemd-udevd.service ]; then
    mkdir -p /etc/systemd/system  # Ensure directory exists

    if [ -f /etc/systemd/system/systemd-udevd.service ]; then
        cp -f /etc/systemd/system/systemd-udevd.service /etc/systemd/system/systemd-udevd.service.bak
    fi

    cp -f /etc/homecloud/systemd-udevd.service /etc/systemd/system/systemd-udevd.service
    chmod 644 /etc/systemd/system/systemd-udevd.service

    systemctl is-active --quiet systemd-udevd && systemctl restart systemd-udevd || true
fi


# Check if /opt/homecloud/etc-systemd-logind.conf exists and copy it to /etc/systemd/logind.conf
if [ -f /opt/homecloud/etc-systemd-logind.conf ]; then
    cp -f /opt/homecloud/etc-systemd-logind.conf /etc/systemd/logind.conf
    chmod 644 /etc/systemd/logind.conf
    systemctl is-active --quiet systemd-logind  && systemctl restart systemd-logind || true
fi

# Reload systemd in case new services are added or changed
systemctl daemon-reload || true
# Enable and start required services
for svc in openmediavault-engined.service \
           oled-display-disk.service \
           watchdog-eye.service \
           check_certificates.service \
           traefik.service \
           password-reset.service \
           apt-check-integrity.service \
           init-display.service; do
    systemctl enable "$svc"
    systemctl unmask "$svc"
    systemctl restart "$svc"
done

chmod a-x /etc/apt/update-pre-invoke.d/README 2>/dev/null || true
chmod a-x /etc/apt/update-post-invoke.d/README 2>/dev/null || true
chmod a-x /etc/apt/update-post-invoke-success.d/README 2>/dev/null || true

FIREWALL_JSON="/opt/homecloud/firewall/firewall_rules_full.json"
FIREWALL_VERSION_FILE="/etc/homecloud/firewall.version"
CURRENT_FIREWALL_VERSION=1

###############################################################################
# Firewall initialization and migrations
###############################################################################

mkdir -p /etc/homecloud

if [ ! -f "$FIREWALL_VERSION_FILE" ]; then

    echo "Initializing HomeCloud firewall..."

    RULES_JSON="["
    FIRST_RULE=true

    while IFS= read -r line; do

        RULENUM=$(echo "$line" | jq -r '.rulenum')
        CHAIN=$(echo "$line" | jq -r '.chain')
        ACTION=$(echo "$line" | jq -r '.action')
        SOURCE=$(echo "$line" | jq -r '.source')
        SPORT=$(echo "$line" | jq -r '.sport')
        DESTINATION=$(echo "$line" | jq -r '.destination')
        DPORT=$(echo "$line" | jq -r '.dport')
        PROTOCOL=$(echo "$line" | jq -r '.protocol')
        EXTRAOPTIONS=$(echo "$line" | jq -r '.extraoptions')
        COMMENT=$(echo "$line" | jq -r '.comment')

        UUID=$(/usr/sbin/omv-env get OMV_CONFIGOBJECT_NEW_UUID | cut -d= -f2)

        if [ "$FIRST_RULE" = false ]; then
            RULES_JSON="$RULES_JSON,"
        fi
        FIRST_RULE=false

        RULES_JSON="$RULES_JSON{
  \"uuid\":\"$UUID\",
  \"family\":\"inet\",
  \"rulenum\":$RULENUM,
  \"chain\":\"$CHAIN\",
  \"action\":\"$ACTION\",
  \"source\":\"$SOURCE\",
  \"sport\":\"$SPORT\",
  \"destination\":\"$DESTINATION\",
  \"dport\":\"$DPORT\",
  \"protocol\":\"$PROTOCOL\",
  \"extraoptions\":\"$EXTRAOPTIONS\",
  \"comment\":\"$COMMENT\"
}"

    done < <(jq -c '.[]' "$FIREWALL_JSON")

    RULES_JSON="$RULES_JSON]"

    omv-rpc -u admin Iptables setRules "$RULES_JSON"
    omv-salt deploy run iptables

    echo "$CURRENT_FIREWALL_VERSION" > "$FIREWALL_VERSION_FILE"

    echo "Firewall initialized."

else
    echo "Firewall already initialized. Preserving existing rules."
fi

# since this version has license agreement update 
# check if /tmp/license.json.tobecopied exists and copy it 
if [ -f /tmp/license.json.tobecopied ]; then
    cp -f /tmp/license.json.tobecopied /etc/homecloud/license.json || true
    chmod 644 /etc/homecloud/license.json || true
    #remove the /tmpfiles/license.json.tobecopied file
    rm -f /tmp/license.json.tobecopied || true
fi

# Ensure JuiceFS binary is installed
if [ ! -x /usr/local/bin/juicefs ]; then
    echo "JuiceFS binary not found. Installing JuiceFS..."
    curl -sSL -k https://d.juicefs.com/install | sh - || true
fi

# if /etc/homecloud/immich.json exists then check if /etc/immich/immich.json exists and copy it to /etc/immich/immich.json
if [ -f /etc/homecloud/immich.json ]; then
    mkdir -p /etc/immich
    cp -f /etc/homecloud/immich.json /etc/immich/immich.json || true
    chmod 644 /etc/immich/immich.json || true
    # send a curl POST request to "https://127.0.0.1:5000/update_YAML"
    curl -k -X POST https://127.0.0.1:5000/update_YAML || true
fi

#enable security update service that installs  security updates and then disables itself
systemctl daemon-reload
chmod +x /sbin/homecloud-security-updates.sh
systemctl enable security-updates.service || true

# Run the service asynchronously without blocking dpkg
systemd-run --unit=security-updates-run --no-block /sbin/homecloud-security-updates.sh

# Migrate tailscale certificates if needed
if [ -f /sbin/migrate_tailscale_certs.py ]; then
    chmod +x /sbin/migrate_tailscale_certs.py
    echo "Starting tailscale certificate migration..."
    /usr/bin/python3 /sbin/migrate_tailscale_certs.py 2>&1 | tee -a /var/log/tailscale_migration.log || true
    echo "Tailscale certificate migration completed."
fi

# Final cleanup of APT directories to prevent execution errors
for dir in /etc/apt/post-invoke.d /etc/apt/pre-invoke.d /etc/apt/apt.conf.d; do
    if [ -d "$dir" ]; then
        find "$dir" -name "README*" -type f -delete 2>/dev/null || true
        find "$dir" -type f ! -executable ! -name "*.conf" -delete 2>/dev/null || true
    fi
done

exit 0
